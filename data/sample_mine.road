N 6 STEEP_LOW 800 650 -60
N 7 STEEP_TOP 800 900 0
N 8 RAMP_LOW_E 1100 550 -80
N 9 RAMP_MID_E 1300 800 -40
N 10 RAMP_TOP_E 1200 1100 0
